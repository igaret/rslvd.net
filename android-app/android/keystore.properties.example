# Copy this file to keystore.properties and fill in your upload-key details.
# keystore.properties is gitignored — never commit it or the .jks file.
#
# Generate an upload keystore once with:
#   keytool -genkeypair -v -keystore rslvd-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias rslvd
#
# storeFile is resolved relative to the android-app/ directory.

storeFile=rslvd-upload.jks
storePassword=CHANGE_ME
keyAlias=rslvd
keyPassword=CHANGE_ME

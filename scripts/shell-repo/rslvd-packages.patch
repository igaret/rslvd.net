index 0000000..8cb4cbd
--- /dev/null
+++ b/packages/rslvd-keyring/build.sh
@@ -0,0 +1,27 @@
+TERMUX_PKG_HOMEPAGE=https://repo.rslvd.net
+TERMUX_PKG_DESCRIPTION="GPG public key for the rslvd package repository (repo.rslvd.net)"
+TERMUX_PKG_LICENSE="Apache-2.0"
+TERMUX_PKG_MAINTAINER="rslvd <repo@rslvd.net>"
+TERMUX_PKG_VERSION=1.0
+TERMUX_PKG_AUTO_UPDATE=false
+TERMUX_PKG_SKIP_SRC_EXTRACT=true
+TERMUX_PKG_PLATFORM_INDEPENDENT=true
+TERMUX_PKG_ESSENTIAL=true
+TERMUX_PKG_PROVIDES="termux-keyring (= 3.14)"
+TERMUX_PKG_REPLACES="termux-keyring"
+TERMUX_PKG_CONFLICTS="termux-keyring"
+
+termux_step_make_install() {
+	local GPG_SHARE_DIR="$TERMUX_PREFIX/share/rslvd-keyring"
+
+	rm -rf "$GPG_SHARE_DIR"
+	mkdir -p "$GPG_SHARE_DIR"
+
+	# Signing key for https://repo.rslvd.net/apt/rslvd-main (InRelease / Release.gpg).
+	install -Dm644 "$TERMUX_PKG_BUILDER_DIR/rslvd-repo.gpg" "$GPG_SHARE_DIR/rslvd-repo.gpg"
+
+	local GPG_DIR="$TERMUX_PREFIX/etc/apt/trusted.gpg.d"
+	mkdir -p "$GPG_DIR"
+	find "$GPG_DIR" -xtype l -printf 'Deleting removed key: %p\n' -delete
+	ln -sf "$GPG_SHARE_DIR/rslvd-repo.gpg" "$GPG_DIR/rslvd-repo.gpg"
+}

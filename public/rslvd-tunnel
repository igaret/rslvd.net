#!/usr/bin/env bash
# rslvd-tunnel — CGNAT bypass tunnel client
# Usage: rslvd-tunnel <TOKEN> <LOCAL_PORT> [LOCAL_HOST]
# Example: rslvd-tunnel abc123 8080
#          rslvd-tunnel abc123 8080 192.168.1.5
#
# One-line install: curl -fsSL https://rslvd.net/install.sh | bash

VERSION="1.0.0"
API_BASE="https://rslvd.net/api"
TUNNEL_HOST="rslvd.net"
RECONNECT_DELAY=5
MAX_RECONNECT_ATTEMPTS=0  # 0 = unlimited

# ── Color helpers ─────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[rslvd]${RESET} $*"; }
success() { echo -e "${GREEN}[rslvd]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[rslvd]${RESET} $*"; }
error()   { echo -e "${RED}[rslvd]${RESET} $*" >&2; }
bold()    { echo -e "${BOLD}$*${RESET}"; }

# ── Dependency check ──────────────────────────────────────────────────────────
check_deps() {
  for cmd in ssh curl; do
    if ! command -v "$cmd" &>/dev/null; then
      error "Required command not found: $cmd"
      echo "  Install with: sudo apt install openssh-client curl"
      exit 1
    fi
  done
}

# ── Fetch tunnel config from API ──────────────────────────────────────────────
fetch_tunnel() {
  local token="$1"
  local resp
  resp=$(curl -sf "$API_BASE/tunnels/connect/$token" 2>/dev/null)
  if [ $? -ne 0 ] || [ -z "$resp" ]; then
    error "Could not reach rslvd.net — check your internet connection"
    return 1
  fi
  echo "$resp"
}

# ── Parse JSON field (no jq needed) ──────────────────────────────────────────
json_field() {
  local json="$1" field="$2"
  echo "$json" | grep -o "\"$field\":[^,}]*" | head -1 | sed 's/.*: *//;s/[",}]//g;s/^ *//;s/ *$//'
}

# ── Setup SSH keys automatically ──────────────────────────────────────────────
setup_ssh_key() {
  local keyfile="$HOME/.ssh/rslvd_ed25519"
  if [ ! -f "$keyfile" ]; then
    info "Generating SSH key for tunnel..."
    mkdir -p "$HOME/.ssh"
    ssh-keygen -t ed25519 -f "$keyfile" -N "" -C "rslvd-tunnel" -q
    success "SSH key created: $keyfile"
  fi
  echo "$keyfile"
}

# ── Register public key with server ──────────────────────────────────────────
register_key() {
  local token="$1" pubkey_file="$2"
  local pubkey
  pubkey=$(cat "${pubkey_file}.pub")
  local resp
  resp=$(curl -sf -X POST "$API_BASE/tunnels/register-key" \
    -H "Content-Type: application/json" \
    -d "{\"token\":\"$token\",\"pubkey\":\"$pubkey\"}" 2>/dev/null)
  echo "$resp"
}

# ── Connect tunnel ────────────────────────────────────────────────────────────
connect_tunnel() {
  local token="$1" local_port="$2" local_host="${3:-localhost}"

  check_deps

  bold ""
  bold "  rslvd-tunnel v$VERSION"
  bold ""
  info "Fetching tunnel config..."

  # Get tunnel info
  local tunnel_json
  tunnel_json=$(fetch_tunnel "$token") || exit 1

  local tunnel_id remote_port fqdn name
  tunnel_id=$(json_field "$tunnel_json" "id")
  remote_port=$(json_field "$tunnel_json" "tunnel_port")
  fqdn=$(json_field "$tunnel_json" "fqdn")
  name=$(json_field "$tunnel_json" "name")

  if [ -z "$remote_port" ] || [ "$remote_port" = "null" ]; then
    error "Invalid token or tunnel not found"
    echo "  Get your token from: https://rslvd.net/dashboard"
    exit 1
  fi

  # Setup SSH key and register it
  local keyfile
  keyfile=$(setup_ssh_key)
  info "Registering SSH key with server..."
  register_key "$token" "$keyfile" >/dev/null 2>&1 || true

  success "Tunnel: ${BOLD}${name}${RESET}"
  success "Public URL: ${BOLD}${fqdn}:${remote_port}${RESET}"
  success "Forwarding: ${BOLD}${local_host}:${local_port}${RESET} → public"
  echo ""
  info "Press Ctrl+C to stop the tunnel"
  echo ""

  local attempt=0
  while true; do
    attempt=$((attempt + 1))
    [ $attempt -gt 1 ] && warn "Reconnecting (attempt $attempt)..."

    # SSH reverse tunnel with keepalive and auto-accept host key on first connect
    ssh \
      -i "$keyfile" \
      -o StrictHostKeyChecking=accept-new \
      -o ServerAliveInterval=30 \
      -o ServerAliveCountMax=3 \
      -o ExitOnForwardFailure=yes \
      -o ConnectTimeout=10 \
      -p 22 \
      -R "${remote_port}:${local_host}:${local_port}" \
      "tunnel@${TUNNEL_HOST}" \
      -N -T \
      2>/dev/null

    local exit_code=$?

    if [ $exit_code -eq 0 ]; then
      info "Tunnel closed."
      break
    fi

    if [ "$MAX_RECONNECT_ATTEMPTS" -gt 0 ] && [ "$attempt" -ge "$MAX_RECONNECT_ATTEMPTS" ]; then
      error "Max reconnection attempts reached. Exiting."
      exit 1
    fi

    warn "Connection lost. Retrying in ${RECONNECT_DELAY}s..."
    sleep "$RECONNECT_DELAY"
  done
}

# ── Main ──────────────────────────────────────────────────────────────────────
case "${1:-}" in
  --version|-v)
    echo "rslvd-tunnel $VERSION"
    ;;
  --help|-h|"")
    bold ""
    bold "  rslvd-tunnel — CGNAT bypass tunnel"
    bold ""
    echo "  Usage:"
    echo "    rslvd-tunnel <TOKEN> <LOCAL_PORT> [LOCAL_HOST]"
    echo ""
    echo "  Examples:"
    echo "    rslvd-tunnel abc123 8080          # Expose localhost:8080"
    echo "    rslvd-tunnel abc123 80            # Expose localhost:80"
    echo "    rslvd-tunnel abc123 3000 0.0.0.0  # Expose all interfaces:3000"
    echo ""
    echo "  Get your token from: https://rslvd.net/dashboard"
    bold ""
    ;;
  *)
    TOKEN="$1"
    LOCAL_PORT="${2:-}"
    LOCAL_HOST="${3:-localhost}"

    if [ -z "$LOCAL_PORT" ]; then
      error "Local port required"
      echo "  Usage: rslvd-tunnel <TOKEN> <LOCAL_PORT>"
      exit 1
    fi

    if ! [[ "$LOCAL_PORT" =~ ^[0-9]+$ ]] || [ "$LOCAL_PORT" -lt 1 ] || [ "$LOCAL_PORT" -gt 65535 ]; then
      error "Invalid port: $LOCAL_PORT"
      exit 1
    fi

    connect_tunnel "$TOKEN" "$LOCAL_PORT" "$LOCAL_HOST"
    ;;
esac

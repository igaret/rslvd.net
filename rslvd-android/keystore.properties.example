# Copy to keystore.properties and fill in your release signing details.
# keystore.properties is git-ignored and must never be committed.
#
# Generate an upload keystore:
#   keytool -genkeypair -v -keystore rslvd-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias rslvd -storepass <pass> -keypass <pass> \
#     -dname "CN=rslvd.net, O=rslvd, C=US"

storeFile=rslvd-upload.jks
storePassword=CHANGE_ME
keyAlias=rslvd
keyPassword=CHANGE_ME

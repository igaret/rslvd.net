diff --git a/scripts/rslvd_rebrand.sh b/scripts/rslvd_rebrand.sh
new file mode 100644
index 0000000..bc62f58
--- /dev/null
+++ b/scripts/rslvd_rebrand.sh
@@ -0,0 +1,44 @@
+# Helpers shared by the rslvd-* packages (forked from termux-*).
+#
+# rslvd_rebrand_bins: in the massaged package tree, rename every
+# `bin/termux-<x>` to `bin/rslvd-<x>` and leave `termux-<x>` behind as a
+# symlink so scripts (and users) that still use the old name keep working.
+rslvd_rebrand_bins() {
+	local bindir="$TERMUX_PKG_MASSAGEDIR/$TERMUX_PREFIX/bin"
+	[ -d "$bindir" ] || return 0
+	local f name new
+	for f in "$bindir"/termux-*; do
+		[ -e "$f" ] || continue
+		name="$(basename "$f")"
+		new="rslvd-${name#termux-}"
+		[ -e "$bindir/$new" ] && continue
+		if [ -L "$f" ]; then
+			# Re-point symlinks at the rslvd-named target when it exists.
+			local target
+			target="$(readlink "$f")"
+			case "$target" in
+				termux-*) ln -sf "rslvd-${target#termux-}" "$bindir/$new" ;;
+				*) ln -sf "$target" "$bindir/$new" ;;
+			esac
+			rm -f "$f"
+		else
+			mv "$f" "$bindir/$new"
+		fi
+		ln -sf "$new" "$f"
+	done
+}
+
+# rslvd_rebrand_replace_string: sed a literal string in all regular text
+# files below the massaged package tree.
+rslvd_rebrand_replace_string() {
+	local from="$1" to="$2"
+	local root="$TERMUX_PKG_MASSAGEDIR/$TERMUX_PREFIX"
+	[ -d "$root" ] || return 0
+	local files
+	files="$(grep -rlI --exclude-dir=installed-tests -F -- "$from" "$root" 2>/dev/null || true)"
+	[ -n "$files" ] || return 0
+	local f
+	while read -r f; do
+		sed -i "s|$from|$to|g" "$f"
+	done <<< "$files"
+}

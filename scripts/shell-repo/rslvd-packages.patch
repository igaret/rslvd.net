new file mode 100644
index 0000000..4c9e863
--- /dev/null
+++ b/packages/rslvd-am-socket/build.sh
@@ -0,0 +1,36 @@
+TERMUX_PKG_HOMEPAGE=https://github.com/termux/termux-am-socket
+TERMUX_PKG_DESCRIPTION="Socket-based am client for the rslvd shell (rslvd build of termux-am-socket)"
+TERMUX_PKG_LICENSE="GPL-3.0"
+TERMUX_PKG_MAINTAINER="@termux"
+TERMUX_PKG_VERSION=1.5.0
+TERMUX_PKG_REVISION=2
+TERMUX_PKG_SRCURL=https://github.com/termux/termux-am-socket/archive/refs/tags/${TERMUX_PKG_VERSION}.tar.gz
+TERMUX_PKG_SHA256=5175023c7fd675492451a72d06b75c772f257685b69fe117227bae5a5e6f5494
+TERMUX_PKG_DEPENDS="libc++"
+TERMUX_PKG_PROVIDES="termux-am-socket (= 1.5.0-2)"
+TERMUX_PKG_REPLACES="termux-am-socket"
+TERMUX_PKG_CONFLICTS="termux-am-socket"
+source "$TERMUX_SCRIPTDIR/scripts/rslvd_rebrand.sh"
+
+termux_step_post_get_source() {
+
+	for file in "${TERMUX_PKG_SRCDIR}/"*; do
+		sed -i'' -E -e "s|^(TERMUX_AM_SOCKET_VERSION=).*|\1$TERMUX_PKG_FULLVERSION|" \
+			-e "s|\@TERMUX_APP_PACKAGE\@|${TERMUX_APP_PACKAGE}|g" \
+			-e "s|\@TERMUX_APPS_DIR\@|${TERMUX_APPS_DIR}|g" \
+			"$file"
+	done
+
+}
+
+termux_step_post_make_install() {
+	# The termux-am wrapper only talks to the app's AM socket server, which the
+	# rslvd app does not run; `am` / `rslvd-am` (rslvd-am package) work instead.
+	rm -f "$TERMUX_PREFIX/bin/termux-am"
+	mv "$TERMUX_PREFIX/bin/termux-am-socket" "$TERMUX_PREFIX/bin/rslvd-am-socket"
+	ln -sf rslvd-am-socket "$TERMUX_PREFIX/bin/termux-am-socket"
+}
+
+termux_step_post_massage() {
+	rslvd_rebrand_replace_string "/data/data/com.termux" "$TERMUX_APP__DATA_DIR"
+}

diff --git a/packages/rslvd-tools/build.sh b/packages/rslvd-tools/build.sh
new file mode 100644
index 0000000..9d0924a
--- /dev/null
+++ b/packages/rslvd-tools/build.sh
@@ -0,0 +1,77 @@
+TERMUX_PKG_HOMEPAGE=https://rslvd.net/
+TERMUX_PKG_DESCRIPTION="Basic system tools for the rslvd shell (rslvd build of termux-tools)"
+TERMUX_PKG_LICENSE="GPL-3.0"
+TERMUX_PKG_MAINTAINER="@termux"
+TERMUX_PKG_VERSION="1.46.0+really1.45.0"
+TERMUX_PKG_REVISION=4
+TERMUX_PKG_SRCURL=https://github.com/termux/termux-tools/archive/refs/tags/v1.45.0.tar.gz
+TERMUX_PKG_SHA256=1ae29b1b875d95cc626dae323b45a2ace759969862d96094b2fa6d13bffe20d2
+TERMUX_PKG_ESSENTIAL=true
+#TERMUX_PKG_AUTO_UPDATE=true
+TERMUX_PKG_UPDATE_TAG_TYPE="newest-tag"
+TERMUX_PKG_BREAKS="termux-keyring (<< 1.9)"
+TERMUX_PKG_PROVIDES="termux-tools (= 1.46.0+really1.45.0-4)"
+TERMUX_PKG_REPLACES="termux-tools"
+TERMUX_PKG_CONFLICTS="termux-tools, procps (<< 3.3.15-2)"
+source "$TERMUX_SCRIPTDIR/scripts/rslvd_rebrand.sh"
+
+# Some of these packages are not dependencies and used only to ensure
+# that core packages are installed after upgrading (we removed busybox
+# from essentials).
+TERMUX_PKG_DEPENDS="bzip2, coreutils, curl, dash, diffutils, findutils, gawk, grep, gzip, less, procps, psmisc, sed, tar, rslvd-am (>= 0.8.0), rslvd-am-socket (>= 1.5.0), rslvd-core, rslvd-exec, rslvd-keyring, util-linux, xz-utils, dialog"
+
+# Optional packages that are distributed as part of bootstrap archives.
+TERMUX_PKG_RECOMMENDS="ed, dos2unix, inetutils, net-tools, patch, unzip"
+
+termux_step_pre_configure() {
+	autoreconf -vfi
+	# configure.ac falls back to com.termux unless these are in the environment.
+	export TERMUX_APP_PACKAGE TERMUX_BASE_DIR TERMUX_CACHE_DIR TERMUX_PREFIX TERMUX_ANDROID_HOME
+}
+
+termux_step_post_make_install() {
+	TERMUX_PKG_CONFFILES="$(cat "$TERMUX_PKG_BUILDDIR/conffiles")"
+
+	# Only repo.rslvd.net serves packages built for this prefix: drop the
+	# Termux mirror list so `pkg` never rotates sources.list onto a Termux mirror.
+	local mirrors="$TERMUX_PREFIX/etc/termux/mirrors"
+	rm -rf "$mirrors"
+	mkdir -p "$mirrors"/{asia,chinese_mainland,europe,north_america,oceania,russia}
+	cat > "$mirrors/default" <<-EOF
+	# This file is sourced by pkg
+	# rslvd package repository (packages built for $TERMUX_PREFIX)
+	WEIGHT=10
+	MAIN="https://repo.rslvd.net/apt/rslvd-main"
+	EOF
+	ln -sf "$mirrors/default" "$TERMUX_PREFIX/etc/termux/chosen_mirrors"
+
+	# Termux Play Store deprecation notice does not apply to rslvd.
+	rm -f "$TERMUX_PREFIX/etc/motd-playstore"
+	cat > "$TERMUX_PREFIX/etc/motd" <<-EOF
+	Welcome to the rslvd shell!
+
+	Dashboard:  https://rslvd.net
+	Packages:   https://repo.rslvd.net
+
+	Working with packages:
+
+	 - Search:  pkg search <query>
+	 - Install: pkg install <package>
+	 - Upgrade: pkg upgrade
+
+	Run 'rslvd-info' to print environment details for support tickets.
+	EOF
+}
+
+termux_step_post_massage() {
+	rslvd_rebrand_bins
+	rslvd_rebrand_replace_string "/data/data/com.termux" "$TERMUX_APP__DATA_DIR"
+	rslvd_rebrand_replace_string "libexec/termux-am/" "libexec/rslvd-am/"
+	rslvd_rebrand_replace_string "cache/termux-am" "cache/rslvd-am"
+}
+
+termux_step_create_debscripts() {
+	cat <<- EOF > ./preinst
+	$(cat "$TERMUX_PKG_BUILDDIR/preinst")
+	EOF
+}
